{
    "name": "dutch-textile-trade",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=26.5.1",
        "bun": ">=1.3.14"
    },
    "packageManager": "bun@1.3.14",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "audit:copy": "node scripts/audit-copy.mjs",
        "format": "prettier --write src scripts package.json README.md DESIGN.md svelte.config.js tsconfig.json vite.config.ts",
        "format:check": "prettier --check src scripts package.json README.md DESIGN.md svelte.config.js tsconfig.json vite.config.ts",
        "audit:data": "node scripts/audit-data.mjs",
        "audit:site": "node scripts/audit-site.mjs"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@types/d3-geo": "^3.1.0",
        "@types/node": "^24.10.0",
        "d3-geo": "^3.1.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.4",
        "typescript": "^6.0.0",
        "vite": "^8.2.0"
    },
    "dependencies": {
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@fontsource-variable/newsreader": "^5.3.0",
        "@lucide/svelte": "^1.28.0",
        "@types/leaflet": "^1.9.22",
        "csv-parse": "^7.0.1",
        "leaflet": "^1.9.4"
    }
}
